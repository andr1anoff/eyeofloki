GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=medium
TAVILY_API_KEY=tvly-your-tavily-api-key
EYE_OF_LOKI_SHARED_SECRET=replace-with-openssl-rand-hex-32
# Must list the exact origin your frontend is served from, no trailing slash.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:4173
MAX_CONTESTS_PER_RECON=10
SEARCH_RESULTS_PER_CONTEST=4
DISCOVERY_QUERIES_PER_RUN=8
DISCOVERY_RESULTS_PER_QUERY=8
MAX_DISCOVERY_CANDIDATES=18
DISCOVERY_MIN_SCORE=45
# Reject anything longer than roughly 1:3300. Raise to be pickier.
DISCOVERY_MIN_CHANCE_PPM=300
# Aggregator hint threshold. Above this, the page is still assessed but its
# outbound contest links are followed as extra candidates.
DISCOVERY_MAX_HUB_SCORE=45
# Only surface contests found in the last month. Empty = no recency filter.
DISCOVERY_TIME_RANGE=month
# How many links to follow off an aggregator page per run.
DISCOVERY_MAX_HARVESTED=8
# Comma-separated hosts to skip before spending Gemini tokens on them.
# Populate after the first live run with the aggregators that keep showing up.
DISCOVERY_BLOCKED_HOSTS=
